/* Minimal config.h for building espeak-ng with the Android NDK.
 *
 * espeak-ng normally gets this file from autotools. The defines below are a
 * curated subset of a typical Linux config.h - just enough for the library
 * sources. If the first real build complains about a missing HAVE_* macro,
 * add it here (this file is the KNOWN-ITERATIVE part of the native build;
 * see README "First-build iteration").
 */
#ifndef ESPEAK_NG_ANDROID_CONFIG_H
#define ESPEAK_NG_ANDROID_CONFIG_H

#define STDC_HEADERS 1
#define WORDS_BIGENDIAN 0

#define HAVE_DLFCN_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_MMAP 1
#define HAVE_MLOCK 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRCASESTR 1
#define HAVE_STRCHRNUL 1
#define HAVE_STRING_H 1
#define HAVE_STRNDUP 1
#define HAVE_SYS_MMAN_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1
#define HAVE_WCHAR_H 1
#define HAVE_WCTYPE_H 1

/* Audio backends: not bundled; synthesis renders to memory, never to a device. */
#define HAVE_PCAUDIOLIB 0
#define HAVE_PULSE 0
#define HAVE_SONIC_H 0

#define PACKAGE_VERSION "1.52.0"

#endif /* ESPEAK_NG_ANDROID_CONFIG_H */
